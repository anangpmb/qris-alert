<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="28dp"
        android:paddingRight="20dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/Text.Title"
            android:accessibilityHeading="true"
            android:text="QRIS Alert" />

        <TextView
            style="@style/Text.Muted"
            android:layout_marginTop="4dp"
            android:text="Teruskan pembayaran QRIS dari HP ke widget OBS." />

        <!-- Izin HP -->

        <TextView
            style="@style/Text.Section"
            android:layout_marginTop="32dp"
            android:accessibilityHeading="true"
            android:text="Izin HP" />

        <LinearLayout
            android:id="@+id/permCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/rowAccess"
                style="@style/Row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Label"
                        android:text="Akses notifikasi" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/accessDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/dot" />

                        <TextView
                            android:id="@+id/accessStatus"
                            style="@style/Text.Muted"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout
                android:id="@+id/rowBattery"
                style="@style/Row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Label"
                        android:text="Optimasi baterai" />

                    <TextView
                        style="@style/Text.Muted"
                        android:layout_marginTop="2dp"
                        android:text="Matikan untuk QRIS Alert dan aplikasi merchant." />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
        </LinearLayout>

        <!-- Server -->

        <TextView
            style="@style/Text.Section"
            android:layout_marginTop="32dp"
            android:accessibilityHeading="true"
            android:text="Server" />

        <TextView
            style="@style/Text.Label"
            android:layout_marginTop="12dp"
            android:labelFor="@id/server"
            android:text="Alamat server" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/server"
                style="@style/Field"
                android:importantForAutofill="no"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="http://192.168.1.10:3000"
                android:inputType="textUri" />

            <Button
                android:id="@+id/btnFind"
                style="@style/Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Cari" />
        </LinearLayout>

        <TextView
            android:id="@+id/serverHint"
            style="@style/Text.Muted"
            android:layout_marginTop="6dp"
            android:accessibilityLiveRegion="polite"
            android:text="Ketuk Cari untuk menemukan server di Wi-Fi yang sama." />

        <TextView
            style="@style/Text.Label"
            android:layout_marginTop="20dp"
            android:labelFor="@id/token"
            android:text="App token" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/token"
                style="@style/Field"
                android:importantForAutofill="no"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="Ambil, atau tempel dari server"
                android:inputType="textVisiblePassword|textNoSuggestions" />

            <Button
                android:id="@+id/btnPair"
                style="@style/Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Ambil" />
        </LinearLayout>

        <TextView
            android:id="@+id/tokenHint"
            style="@style/Text.Muted"
            android:layout_marginTop="6dp"
            android:accessibilityLiveRegion="polite"
            android:text="Ketuk Ambil, lalu klik Izinkan di dashboard PC." />

        <LinearLayout
            android:id="@+id/pairBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_muted"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                style="@style/Text.Muted"
                android:text="Kode di dashboard PC" />

            <TextView
                android:id="@+id/pairCode"
                style="@style/Text"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.2"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Text.Muted"
                android:layout_marginTop="6dp"
                android:text="Buka dashboard QRIS Alert di PC, pastikan kodenya sama, lalu klik Izinkan. Dashboard belum terbuka? Klik dua kali Mulai QRIS Alert." />

            <Button
                android:id="@+id/btnPairCancel"
                style="@style/Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:layout_marginTop="4dp"
                android:text="Batal" />
        </LinearLayout>

        <!-- Filter notifikasi -->

        <TextView
            style="@style/Text.Section"
            android:layout_marginTop="32dp"
            android:accessibilityHeading="true"
            android:text="Filter notifikasi" />

        <TextView
            style="@style/Text.Label"
            android:layout_marginTop="12dp"
            android:labelFor="@id/packages"
            android:text="Aplikasi yang dipantau" />

        <EditText
            android:id="@+id/packages"
            style="@style/Field"
            android:importantForAutofill="no"
            android:layout_marginTop="8dp"
            android:hint="id.dana"
            android:inputType="textNoSuggestions" />

        <TextView
            style="@style/Text.Muted"
            android:layout_marginTop="6dp"
            android:text="Nama paket aplikasi, pisahkan dengan koma. Pakai mode deteksi untuk mencari tahu." />

        <TextView
            style="@style/Text.Label"
            android:layout_marginTop="20dp"
            android:labelFor="@id/keywords"
            android:text="Kata kunci pembayaran" />

        <EditText
            android:id="@+id/keywords"
            style="@style/Field"
            android:importantForAutofill="no"
            android:layout_marginTop="8dp"
            android:hint="diterima, menerima"
            android:inputType="textNoSuggestions" />

        <TextView
            style="@style/Text.Muted"
            android:layout_marginTop="6dp"
            android:text="Cukup salah satu kata ada di notifikasi. Ini mencegah notifikasi promo ikut terbaca." />

        <LinearLayout
            android:id="@+id/optionsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <Switch
                android:id="@+id/speak"
                style="@style/Row"
                android:minHeight="56dp"
                android:switchPadding="16dp"
                android:text="Bacakan nominal di HP ini"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <View style="@style/Divider" />

            <Switch
                android:id="@+id/detect"
                style="@style/Row"
                android:minHeight="56dp"
                android:switchPadding="16dp"
                android:text="Mode deteksi: catat semua notifikasi"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSave"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Simpan pengaturan" />

        <Button
            android:id="@+id/btnTest"
            style="@style/Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Kirim pembayaran tes" />

        <!-- Catatan -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Section"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="Catatan" />

            <Button
                android:id="@+id/btnRefresh"
                style="@style/Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Muat ulang" />

            <Button
                android:id="@+id/btnClear"
                style="@style/Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="-12dp"
                android:text="Hapus"
                android:textColor="@color/danger" />
        </LinearLayout>

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_muted"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.15"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textIsSelectable="true"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
